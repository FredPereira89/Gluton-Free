    {
      "name": "Tier Badge",
      "kind": "custom",
      "refersTo": "tier-badge",
      "description": "Capsule with outline, fill, five round pips and label. Dashed when provisional.",
      "html": "<span class=\"ds-tier\"><span class=\"ds-pips\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i></span>Good</span> <span class=\"ds-tier ds-dashed\"><span class=\"ds-pips\"><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i><i></i></span>OK</span>",
      "css": ".ds-tier{display:inline-flex;align-items:center;gap:10px;color:var(--ink);background:var(--t-good-bg);border:2px solid var(--t-good);border-radius:999px;padding:6px 14px;font-weight:700;white-space:nowrap;transition:transform 160ms ease}.ds-tier:hover{transform:scale(1.04)}.ds-pips{display:inline-flex;gap:4px}.ds-pips i{width:9px;height:9px;border-radius:50%;box-shadow:inset 0 0 0 1.5px var(--t-good)}.ds-pips i.on{background:var(--t-good)}.ds-dashed{border-style:dashed;background:var(--t-ok-bg);border-color:var(--t-ok)}.ds-dashed .ds-pips i{box-shadow:inset 0 0 0 1.5px var(--t-ok)}.ds-dashed .ds-pips i.on{background:var(--t-ok)}@media (prefers-reduced-motion:reduce){.ds-tier{transition:none}.ds-tier:hover{transform:none}}"
    },
